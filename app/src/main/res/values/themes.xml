<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.N2n" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text</item>
        <item name="colorSurfaceVariant">@color/brand_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/brand_text_dim</item>
        <item name="colorError">@color/brand_danger</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
    </style>

    <style name="Widget.N2n.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_accent</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_text_dim</item>
        <item name="android:textColorHint">@color/brand_text_dim</item>
    </style>
</resources>
